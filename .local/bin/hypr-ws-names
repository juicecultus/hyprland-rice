#!/usr/bin/env python3
"""Waybar custom workspaces module for Hyprland.

Shows persistent workspaces 1-5, but the *active* workspace displays the
focused window's app name instead of its number, e.g. "Claude  2  3  4  5".
Event-driven: connects to Hyprland's .socket2.sock and reprints on every
focus/workspace/window change, so it updates instantly (no polling lag).
No external deps beyond hyprctl + python3.
"""
import json
import os
import socket
import subprocess
import sys

N = 5  # persistent workspaces

# Curated class -> pretty name. Fallback cleans the raw class.
PRETTY = {
    "io.github.aaddrick.claude-desktop-debian": "Claude",
    "Alacritty": "Terminal",
    "thunar": "Files",
    "Thunar": "Files",
    "firefox": "Firefox",
    "zen": "Zen",
    "chromium": "Chromium",
    "Chromium": "Chromium",
    "pavucontrol": "Audio",
    "nm-connection-editor": "Network",
    "org.pwmt.zathura": "Zathura",
    "mpv": "mpv",
    "imv": "imv",
}

ACTIVE_FG = "#7aa2f7"
IDLE_FG = "#565f89"


def run(*args):
    return subprocess.run(args, capture_output=True, text=True).stdout


def pretty(cls):
    if not cls:
        return ""
    if cls in PRETTY:
        return PRETTY[cls]
    # last dotted segment, title-cased: org.gnome.Nautilus -> Nautilus
    seg = cls.split(".")[-1]
    return seg[:1].upper() + seg[1:] if seg else cls


def esc(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def state():
    try:
        aw = json.loads(run("hyprctl", "activeworkspace", "-j"))
        active = aw.get("id", 1)
    except Exception:
        active = 1
    cls = ""
    try:
        win = json.loads(run("hyprctl", "activewindow", "-j") or "{}")
        cls = win.get("class") or win.get("initialClass") or ""
    except Exception:
        pass
    return active, cls


def render():
    active, cls = state()
    name = pretty(cls)
    hi = max(N, active)
    parts = []
    for i in range(1, hi + 1):
        if i == active:
            label = name if name else str(i)
            parts.append(
                f'<span foreground="{ACTIVE_FG}" weight="bold">{esc(label)}</span>'
            )
        else:
            parts.append(f'<span foreground="{IDLE_FG}">{i}</span>')
    text = "  ".join(parts)
    tip = f"Workspace {active}" + (f" — {cls}" if cls else "")
    sys.stdout.write(json.dumps({"text": text, "tooltip": tip}) + "\n")
    sys.stdout.flush()


TRIGGERS = (
    "workspace>>", "activewindow>>", "focusedmon>>", "openwindow>>",
    "closewindow>>", "movewindow>>", "activespecial>>", "fullscreen>>",
    "createworkspace>>", "destroyworkspace>>", "moveworkspace>>",
)


def main():
    render()  # initial paint
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    rt = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    if not sig:
        return  # not in a hyprland session; static output is fine
    path = f"{rt}/hypr/{sig}/.socket2.sock"
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(path)
    buf = b""
    while True:
        chunk = s.recv(4096)
        if not chunk:
            break
        buf += chunk
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            ev = line.decode("utf-8", "replace")
            if any(ev.startswith(t) for t in TRIGGERS):
                render()


if __name__ == "__main__":
    main()
